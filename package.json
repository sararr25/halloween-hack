{
  "name": "halloween-hack",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "postinstall": "node scripts/sync-assets.mjs",
    "rive:build": "rive rive/presence --once && cp rive/presence/build/presence.riv public/rive/presence.riv",
